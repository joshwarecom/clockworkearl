{
  "manifest_version": 3,
  "name": "Headsman - Modify Headers (like a boss)",
  "version": "1.0",
  "description": "Exactly what it says on the tin.  Modify Headers (like a boss)",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  }
}